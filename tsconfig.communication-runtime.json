{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "incremental": false,
    "skipLibCheck": true
  },
  "include": [
    "next-env.d.ts",
    "types/next-auth.d.ts",
    "lib/integration-settings/**/*.ts",
    "lib/audit-log.ts",
    "lib/communication/**/*.ts",
    "app/api/communication/**/*.ts",
    "app/api/dashboard/communication/**/*.ts",
    "app/api/cron/communication-*/**/*.ts",
    "app/api/webhooks/meta/whatsapp/**/*.ts",
    "app/api/webhooks/elastic-email/**/*.ts",
    "app/api/webhooks/brevo/**/*.ts",
    "app/(dashboard)/dashboard/communication/**/*.tsx",
    "lib/templates/**/*.ts",
    "lib/events/**/*.ts",
    "app/api/templates/**/*.ts",
    "app/(dashboard)/dashboard/templates/**/*.tsx",
    "components/dashboard/SmartWhatsappDialog.tsx",
    "components/dashboard/SendTemplateDialog.tsx",
    "app/(dashboard)/dashboard/_shell/DashboardTopbar.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".integration-test-build",
    "lib/tracking/**"
  ]
}
