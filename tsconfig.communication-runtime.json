{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "incremental": false,
    "skipLibCheck": true
  },
  "include": [
    "next-env.d.ts",
    "lib/integration-settings/**/*.ts",
    "lib/communication/runtime-config.ts",
    "lib/communication/provider-router.ts",
    "lib/communication/provider-connections.ts",
    "lib/communication/campaign-send-planner.ts",
    "lib/communication/campaign-send-executor.ts",
    "lib/communication/automatic-message-dispatcher.ts",
    "lib/communication/system-email.ts",
    "lib/communication/providers/**/*.ts",
    "lib/events/dispatch.ts",
    "lib/platform-connections/readiness.ts",
    "app/api/webhooks/meta/whatsapp/route.ts",
    "app/api/webhooks/brevo/transactional/route.ts",
    "app/api/dashboard/operations/communication/providers/**/*.ts",
    "app/api/templates/email/send/route.ts",
    "app/api/auth/register/route.ts",
    "app/api/auth/resend-otp/route.ts",
    "app/(dashboard)/dashboard/operations/communication/settings/**/*.tsx",
    "app/(dashboard)/dashboard/operations/communication/providers/**/*.tsx"
  ],
  "exclude": ["node_modules", ".next", ".integration-test-build"]
}
