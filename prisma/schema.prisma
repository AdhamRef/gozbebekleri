/// Daily ad-level snapshot (Meta ads, Google ad_group_ads, TikTok ads, X promoted tweets).
model AdSnapshot {
  id                       String   @id @default(auto()) @map("_id") @db.ObjectId
  connectionId             String   @db.ObjectId
  platform                 String
  accountId                String?
  date                     DateTime
  campaignId               String?
  campaignName             String?
  adGroupId                String?
  adGroupName              String?
  adId                     String
  adName                   String?
  creativeName             String?
  placement                String?
  country                  String?
  spend                    Float    @default(0)
  impressions              Int      @default(0)
  clicks                   Int      @default(0)
  reportedConversions      Float    @default(0)
  reportedConversionValue  Float    @default(0)
  currency                 String?
  raw                      Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([connectionId, date])
  @@index([platform, date])
  @@index([adId, date])
}

/// Daily messaging-campaign snapshot. Used by Twilio campaign analytics and
/// any future email/SMS analytics aggregation. SentMessage stays the
/// per-recipient log — this model is for fast dashboard rollups.
model MarketingCampaignSnapshot {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  connectionId    String?  @db.ObjectId
  /// "TWILIO" | "CUSTOM" | "EMAIL_PROVIDER" | "OTHER"
  provider        String
  /// "TWILIO_EMAIL" | "TWILIO_WHATSAPP" | "TWILIO_SMS" | "EMAIL" | "WHATSAPP" | "SMS"
  channel         String
  campaignId      String?
  campaignName    String?
  templateId      String?
  templateName    String?
  messageVariant  String?
  audienceSegment String?
  date            DateTime
  sent            Int      @default(0)
  delivered       Int      @default(0)
  failed          Int      @default(0)
  opened          Int      @default(0)
  clicked         Int      @default(0)
  replied         Int      @default(0)
  donations       Int      @default(0)
  revenue         Float    @default(0)
  cost            Float    @default(0)
  currency        String?
  raw             Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([connectionId, date])
  @@index([provider, channel, date])
  @@index([campaignId, date])
}
