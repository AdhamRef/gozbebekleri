generator client {
  provider = "prisma-client-js"
  output   = "../generated/integration-settings-client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model IntegrationSetting {
  id                       String   @id @default(auto()) @map("_id") @db.ObjectId
  provider                 String
  key                      String
  encryptedValue           String?  @db.String
  plainValue               String?  @db.String
  isSecret                 Boolean
  enabled                  Boolean  @default(true)
  version                  Int      @default(1)
  source                   String   @default("DATABASE")
  pendingEncryptedValue    String?  @db.String
  pendingVersion           Int?
  pendingCreatedAt         DateTime?
  pendingUpdatedBy         String?  @db.ObjectId
  pendingLastTestAt        DateTime?
  pendingLastTestResult    String?
  pendingFailureReasonSafe String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  updatedBy                String?  @db.ObjectId
  lastTestAt               DateTime?
  lastTestResult           String?
  lastFailureReasonSafe    String?

  @@unique([provider, key])
  @@index([provider, enabled])
  @@index([updatedAt(sort: Desc)])
}
